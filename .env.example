# FaultScope control plane (app/) — copy to .env for local non-Docker runs.
# When running via docker-compose these are set in docker-compose.yml instead.

DATABASE_URL=postgresql+psycopg://aegis:aegis@localhost:5432/aegis
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=aegis-incidents

ENVIRONMENT=development
DEBUG=true

# Fault agent (docker.sock holder). Change for anything that is not a local dev machine.
FAULT_AGENT_TOKEN=dev-token-change-me

# LLM (Ollama on the host). No API key needed; the AI layer degrades to evidence-only if unreachable.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# API keys for state-changing endpoints: key:role (viewer < operator < admin). CHANGE these outside local dev.
FAULTSCOPE_API_KEYS=dev-operator-key:operator,dev-admin-key:admin
